{
  "name": "sc-fleet-matrix",
  "version": "1.0.0",
  "description": "Star Citizen Fleet Matrix",
  "type": "module",
  "scripts": {
    "build-data": "node --watch-path=src/server src/server/data-generation.ts",
    "start": "vite",
    "typecheck": "tsc"
  },
  "keywords": [],
  "author": "Tom Corke",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.32.1",
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "singleQuote": true,
    "importOrder": [
      "<THIRD_PARTY_MODULES>",
      "^@core/(.*)$",
      "^@server/(.*)$",
      "^@ui/(.*)$",
      "^../[./]",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
