{
  "manifest_version": 3,
  "name": "SC Fleet Matrix hangar bridge",
  "version": "1.0.0",
  "description": "Lets the local Fleet Matrix viewer read your RSI hangar.",
  "host_permissions": ["https://robertsspaceindustries.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://localhost/*"], "js": ["content.js"] }
  ]
}
