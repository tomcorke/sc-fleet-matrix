{
  "manifest_version": 3,
  "name": "SC Fleet Matrix bridge",
  "version": "1.1.0",
  "description": "Lets the Fleet Matrix viewer read your RSI hangar and live store offers.",
  "host_permissions": ["https://robertsspaceindustries.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://sc-fleet-matrix.corke.dev/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
